# Branch deployment env template.
# This mirrors the root .env.branch.example so the deploy/branch folder can be copied to a server.
# Browser clients rewrite loopback/private LAN Supabase hosts to the hostname
# used to open the app, so branch mode can survive LAN IP changes.

SUPABASE_PROJECT_ID=branch-local
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=branch-local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

LEAD_CAPTURE_ALLOWED_ORIGINS=http://crm.local,http://crm.local:3000,http://crm.local:5173,http://localhost:3000,http://127.0.0.1:3000
PUBLIC_SITE_ORIGINS=http://crm.local,http://crm.local:3000,http://crm.local:5173,http://localhost:3000,http://127.0.0.1:3000

AUTOMATION_DISPATCH_SECRET=
EMAIL_ENABLED=false
LANDING_FROM_EMAIL=
PARTNER_NAME=
PARTNER_PHONE=
PARTNER_EMAIL=
LANDING_NOTIFY_EMAILS=
SALES_NOTIFY_EMAILS=
SALES_NOTIFY_BCC=
APP_URL=http://crm.local:3000
AUTOMATION_FROM_EMAIL=

SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Cloud sync worker config. By default, scripts use ../../.env.production as
# the cloud sync target when CLOUD_* values are blank in the root .env.branch.
CLOUD_SUPABASE_URL=
CLOUD_SUPABASE_SERVICE_ROLE_KEY=
CLOUD_SUPABASE_PUBLISHABLE_KEY=
CLOUD_SYNC_NODE_ID=
BRANCH_SYNC_NODE_ID=
BRANCH_SYNC_NODE_NAME=
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=30

BRANCH_BACKUP_DIR=backups/branch
BRANCH_DB_URL=
