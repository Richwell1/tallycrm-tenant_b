# ---------------------------------------------------------------------------
# Local development env template.
# Copy to .env.local and fill in the blanks:  cp .env.local.example .env.local
# .env.local is gitignored — never commit real secrets.
# On Lovable Cloud (preview/production) these are injected automatically;
# you only need this file when running the app on your own machine.
# ---------------------------------------------------------------------------

# --- Backend (public, safe to commit) --------------------------------------
SUPABASE_PROJECT_ID="ncggjsjzjfgoceoszjhf"
SUPABASE_URL="https://ncggjsjzjfgoceoszjhf.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_VO_1HPPNw-Y-nGVHLEdK8g_6Dkwq6zV"

VITE_SUPABASE_PROJECT_ID="ncggjsjzjfgoceoszjhf"
VITE_SUPABASE_URL="https://ncggjsjzjfgoceoszjhf.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_VO_1HPPNw-Y-nGVHLEdK8g_6Dkwq6zV"

# --- Landing page lead capture --------------------------------------------
# Comma-separated extra origins allowed to POST to /api/public/leads-capture.
# localhost is already trusted outside production.
LEAD_CAPTURE_ALLOWED_ORIGINS=""
PUBLIC_SITE_ORIGINS=""

# --- Lead confirmation email ----------------------------------------------
EMAIL_ENABLED="true"
# Verified Resend sender, e.g. "TallyPrime <hello@yourdomain.com>".
# Leave blank to fall back to onboarding@resend.dev (owner-only delivery).
LANDING_FROM_EMAIL=""
AUTOMATION_FROM_EMAIL=""
PARTNER_NAME=""
PARTNER_PHONE=""
PARTNER_EMAIL=""
SALES_NOTIFY_BCC=""

# --- Server-only secrets (never prefix with VITE_) -------------------------
# Shared secret for the send-automation-email function. Generate one with:
#   openssl rand -hex 32
AUTOMATION_DISPATCH_SECRET=""

# Local-only. On Lovable Cloud these are managed and injected at runtime,
# and their values are not exposed — leave blank there.
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
