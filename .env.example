SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated origins allowed to post to the public lead capture endpoint
# when the landing page and API are on different production origins.
LEAD_CAPTURE_ALLOWED_ORIGINS=
PUBLIC_SITE_ORIGINS=

# Shared secret required by the send-automation-email edge function.
# Store the same value in the app server and Supabase edge function secrets.
AUTOMATION_DISPATCH_SECRET=

# Lead-capture confirmation email config.
EMAIL_ENABLED=true
LANDING_FROM_EMAIL=
PARTNER_NAME=
PARTNER_PHONE=
PARTNER_EMAIL=
SALES_NOTIFY_BCC=

# Automation email config.
AUTOMATION_FROM_EMAIL=

# Server/edge secrets. Never expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
