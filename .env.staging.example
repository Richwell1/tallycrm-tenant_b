# Staging Cloudflare/Supabase environment.
# Copy to .env.staging for local staging builds. Do not use production keys here.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Staging public origins. Include the staging workers.dev/custom domain.
LEAD_CAPTURE_ALLOWED_ORIGINS=
PUBLIC_SITE_ORIGINS=

AUTOMATION_DISPATCH_SECRET=

EMAIL_ENABLED=false
LANDING_FROM_EMAIL=
PARTNER_NAME=
PARTNER_PHONE=
PARTNER_EMAIL=
LANDING_NOTIFY_EMAILS=
SALES_NOTIFY_EMAILS=
SALES_NOTIFY_BCC=
APP_URL=

AUTOMATION_FROM_EMAIL=

# Server/edge secrets. Never expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
